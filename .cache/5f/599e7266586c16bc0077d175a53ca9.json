        .then((res) => {\r\n          console.log(res.data);\r\n          alert('Payment successful! Tour booked.');\r\n        })\r\n        .catch((err) => {\r\n          console.error('Error confirming payment:', err);\r\n          alert('Payment successful but failed to book tour. Please contact support.');\r\n        });\r\n      },\r\n      onClose: function() {\r\n        alert('Payment window closed.');\r\n      }\r\n    });\r\n\r\n    // Open the Paystack payment modal\r\n    handler.openIframe();\r\n\r\n  } catch (err) {\r\n    console.error('Error during booking process:', err);\r\n    alert('An error occurred while trying to book the tour. Please try again.');\r\n  }\r\n};"},"lineCount":null}},"error":null,"hash":"89746401f0d2d0c7028a50b882a7d745","cacheData":{"env":{}}}