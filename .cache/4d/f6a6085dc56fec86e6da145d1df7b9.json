e":75,"column":27},"source":"flutterwave.js","original":{"line":62,"column":2}}],"sources":{"flutterwave.js":"const axios = require(\"axios\");\r\n\r\n// Flutterwave API keys\r\nconst FLUTTERWAVE_PUBLIC_KEY = process.env.FLUTTERWAVE_PUBLIC_KEY; // Replace with your Flutterwave public key\r\n\r\nexport const bookTour = async (tourId, userEmail, tourPrice, tourName, tourSummary) => {\r\n  try {\r\n    // 1) Initialize Flutterwave payment\r\n    const paymentData = {\r\n      public_key: FLUTTERWAVE_PUBLIC_KEY, // Flutterwave public key\r\n      tx_ref: `tx-ref-${Date.now()}`, // Unique transaction reference\r\n      amount: tourPrice * 100, // Amount in kobo (e.g., 10000 for NGN 100.00)\r\n      currency: \"NGN\", // Currency code (e.g., NGN, USD, GHS)\r\n      payment_options: \"card, mobilemoney, ussd\", // Payment methods\r\n      redirect_url: `http://127.0.0.1:3000/api/v1/bookings/confirmPayment`, // Redirect after payment\r\n      meta: {\r\n        tourId: tourId, // Tour ID\r\n        userEmail: userEmail, // User's email\r\n      },\r\n      customer: {\r\n        email: userEmail, // Customer email\r\n        phone_number: \"\", // Customer phone number (optional)\r\n        name: \"\", // Customer name (optional)\r\n      },\r\n      customizations: {\r\n        title: `${tourName} Tour`, // Payment modal title\r\n        description: tourSummary, // Payment modal description\r\n        logo: \"https://your-website.com/logo.png\", // Your logo URL\r\n      },\r\n    };\r\n\r\n    // 2) Open Flutterwave payment modal\r\n    FlutterwaveCheckout({\r\n      ...paymentData,\r\n      callback: function (response) {\r\n        // 3) Send request to API to confirm payment\r\n        axios\r\n          .post(`http://127.0.0.1:3000/api/v1/bookings/confirm-payment`, {\r\n            transaction_id: response.transaction_id,\r\n            tourId: tourId,\r\n            userEmail: userEmail,\r\n          })\r\n          .then((res) => {\r\n            console.log(res.data);\r\n            alert(\"Payment successful! Tour booked.\");\r\n          })\r\n          .catch((err) => {\r\n            console.error(\"Error confirming payment:\", err);\r\n            alert(\r\n              \"Payment successful but failed to book tour. Please contact support.\"\r\n            );\r\n          });\r\n      },\r\n      onclose: function () {\r\n        alert(\"Payment window closed.\");\r\n      },\r\n    });\r\n  } catch (err) {\r\n    console.error(\"Error during booking process:\", err);\r\n    alert(\"An error occurred while trying to book the tour. Please try again.\");\r\n  }\r\n};"},"lineCount":null}},"error":null,"hash":"11e7d421e319e4c361599401a0c6328f","cacheData":{"env":{}}}